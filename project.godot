config_version=5

[application]
config/name="The RPG"
run/main_scene="res://scenes/menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]
Game="*res://src/core/game.gd"
EventBus="*res://src/core/event_bus.gd"
Rng="*res://src/core/rng.gd"
CommandBus="*res://src/core/command_bus.gd"
Settings="*res://src/ui/options_settings.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[internationalization]
locale/translations=PackedStringArray("res://localization/strings.en.translation")
locale/fallback="en"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[navigation]
3d/default_cell_size=0.15
3d/default_cell_height=0.05

[input]
gallery_previous={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":81)]}
gallery_next={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":69)]}
gallery_rotate_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194319)]}
gallery_rotate_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194321)]}
gallery_reset={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":82)]}
gallery_toggle_lighting={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":76)]}
camera_rotate_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":81)]}
camera_rotate_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":69)]}
camera_pan_forward={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":87)]}
camera_pan_back={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":83)]}
camera_pan_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":65)]}
camera_pan_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":68)]}
cancel={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
end_turn={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":32)]}
camera_rotate={"deadzone":0.5,"events":[Object(InputEventMouseButton,"button_index":2)]}
camera_pan={"deadzone":0.5,"events":[Object(InputEventMouseButton,"button_index":3)]}
camera_zoom_in={"deadzone":0.5,"events":[Object(InputEventMouseButton,"button_index":4)]}
camera_zoom_out={"deadzone":0.5,"events":[Object(InputEventMouseButton,"button_index":5)]}
select={"deadzone":0.5,"events":[Object(InputEventMouseButton,"button_index":1)]}

combat_debug={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194334)]}
combat_dash={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":50)]}
combat_disengage={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":51)]}
combat_attack={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":49)]}
