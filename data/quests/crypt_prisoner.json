{
	"version": 1,
	"id": "crypt_prisoner",
	"title": "The stonemason in the cell",
	"start_if": [
		{
			"flag": "crypt_prisoner_key_hint"
		}
	],
	"stages": [
		{
			"text": "Thomas Rehn, a stonemason, is locked in a cell in the crypt, behind the iron gate next to the side chamber."
		},
		{
			"if": [
				{
					"flag": "crypt_key_vaelor"
				}
			],
			"text": "Malrek: Vaelor has the key."
		},
		{
			"if": [
				{
					"flag": "crypt_prisoner_promised"
				}
			],
			"text": "I promised Thomas to get him out."
		}
	],
	"done_if": [
		{
			"flag": "crypt_prisoner_freed"
		}
	],
	"done_text": "Thomas is free.",
	"failed_if": [
		{
			"flag": "thomas_status",
			"is": "dead"
		}
	],
	"failed_text": "Thomas is dead."
}
