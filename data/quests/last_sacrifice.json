{
	"version": 1,
	"id": "last_sacrifice",
	"title": "The last sacrifice",
	"start_if": [
		{
			"flag": "vaelor_pact"
		}
	],
	"stages": [
		{
			"text": "I promised Vaelor a life for his ritual. He waits at the altar."
		},
		{
			"if": [
				{
					"any": [
						{
							"flag": "thomas_status",
							"is": "freed"
