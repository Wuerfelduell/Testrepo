						{
							"flag": "thomas_status",
							"is": "guide"
						}
					]
				}
			],
			"text": "Thomas the stonemason is with me."
		}
	],
	"done_if": [
		{
			"flag": "vaelor_outcome",
			"is": "ritual_completed"
		}
	],
	"done_text": "I brought Vaelor his sacrifice.",
