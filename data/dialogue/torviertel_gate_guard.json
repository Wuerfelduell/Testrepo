	"nodes": {
		"first": {
			"text": "Two guards stand beside a barrier. Garrik sits on a wooden chair, sharpening his dagger, and looks the newcomer over. \"Shut your mouth and stand still.\" He eyes you from head to toe. \"Another damned vagrant with a weapon. What do you want in Rabenfels?\"",
			"effects": {
				"flags": {
					"garrik_met": true
				}
			},
			"choices": [
				{
					"text": "\"I'm looking for work. Maybe someone who needs a sword arm.\"",
					"next": "work"
				},
				{
					"text": "\"None of your damn business.\"",
					"next": "provoked"
				},
				{
					"text": "\"I don't want trouble. I just need somewhere to sleep.\"",
					"next": "fee"
				},
				{
					"text": "\"I could ask why you're doing your duty drunk.\"",
					"next": "drunk"
				},
				{
					"id": "tense",
					"text": "\"Has something happened? You seem unusually tense.\"",
					"check": {
						"skill": "persuasion",
						"dc": 13,
						"success": "eyeless",
						"failure": "tense"
					}
				}
			]
		},
		"work": {
			"text": "\"Great. Another idiot who thinks he's a hero.\" He spits on the ground. \"The adventurers' guild takes any scum. Go there before you start busting my balls. What can you even do? Apart from talking big?\"",
			"choices": [
				{
					"text": "\"I can fight.\"",
					"next": "can_fight"
				},
				{
					"id": "talk",
					"text": "\"I can make people talk.\"",
					"check": {
						"skill": "intimidation",
						"dc": 15,
						"success": "silent_prisoners",
						"failure": "mother"
					}
				},
				{
					"text": "\"Better than you, apparently. I don't need a chair to do my duty.\"",
					"effects": {
						"add": {
							"garrik_relationship": -1
						}
					},
					"next": "chair"
				},
				{
					"text": "\"Do you have a job yourself?\"",
					"if": [
						{
							"flag": "garrik_job",
							"is": false
						}
					],
					"next": "dirty_job"
				}
			]
		},
		"can_fight": {
			"text": "\"Anyone can fight. The trick is not to die doing it.\"",
			"effects": {
				"flags": {
					"hint_adventurers_guild": true
				}
			}
		},
		"silent_prisoners": {
			"text": "\"Then you should go to the city watch. We've got a few prisoners who badly need to talk.\"",
			"effects": {
				"flags": {
					"quest_silent_prisoners": true
				},
				"xp": 25
			}
		},
		"mother": {
			"text": "\"You couldn't even make my mother talk. And she's been dead for ten years.\""
		},
		"chair": {
			"text": "\"One more word and I'll show you what the chair is good for.\""
		},
		"dirty_job": {
			"text": "\"Depends. How much do you mind getting your hands dirty?\" [Placeholder: Garrik wants an inconvenient witness in the poor quarter intimidated.]",
			"choices": [
				{
					"text": "\"I'll do it.\"",
					"effects": {
						"flags": {
							"garrik_job": "accepted"
						},
						"add": {
							"corruption_reputation": 1
						}
					},
					"next": "job_accepted"
				},
				{
					"text": "\"Not my kind of work.\"",
