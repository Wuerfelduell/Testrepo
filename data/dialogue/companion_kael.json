	"nodes": {
		"first": {
			"text": "Kael sits on a crate, cleaning his greatsword.\n\n\"If you're looking for a fight, come back tomorrow.\"\n\nHe looks you over.\n\n\"If you have work, talk. If you want to beg, piss off.\"",
			"effects": {
				"flags": {
					"kael_met": true
				}
			},
			"choices": [
				{
					"text": "I'm looking for a capable fighter.",
					"next": "hire"
				},
				{
					"text": "You look like a deserter.",
					"next": "deserter"
				},
				{
					"text": "I heard you left your men to die.",
					"if": [
						{
							"flag": "kael_rumor_heard"
						}
					],
					"next": "past"
				},
				{
					"text": "You talk big for someone sitting on a crate.",
					"next": "crate"
				},
				{
					"text": "How many people have you killed?",
					"next": "killed"
				},
				{
					"text": "I'll be going."
				}
			]
		},
